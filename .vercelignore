# Keep the serverless bundle small and the build fast. Exclude heavy, non-code,
# or local-only paths. ALL of plugged/ source stays (it's tiny; the weight is in
# dependencies, and excluding individual modules risks breaking an import).
.venv/
node_modules/
tools/
tests/
docs/
data/
.git/
.github/
.claude/
.agents/
*.db
plugged.local.yaml
